# Server Configuration
PORT=3000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=student_db
DB_CONNECTION_LIMIT=10

# JWT Security
JWT_SECRET=your_jwt_secret_key_here

# Automated Email Verification Service (Zero-setup Dev Fallback by default)
# Leave all empty to fall back to the built-in floating Developer Panel.
# To use a service, configure one of the options below.
EMAIL_PROVIDER=
EMAIL_FROM=CampusOS <noreply@campusos.edu>

# Option 1: Brevo (Preferred SMTP Relay)
BREVO_API_KEY=
BREVO_USER=

# Option 2: Resend
RESEND_API_KEY=

# Option 3: Mailtrap (Development Sandbox)
MAILTRAP_USER=
MAILTRAP_PASS=

# Generic/Custom SMTP Config (e.g. Gmail fallback)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_SECURE=false
